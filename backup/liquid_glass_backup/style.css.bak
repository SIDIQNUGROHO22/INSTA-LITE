/* ==========================================================================
   InstaLite — Modern Social Media Web App Stylesheet
   ========================================================================== */

:root {
  --primary: #4f46e5;
  --primary-hover: #4338ca;
  --primary-light: #eef2ff;
  --primary-border: #c7d2fe;
  
  --danger: #dc2626;
  --danger-hover: #b91c1c;
  --danger-light: #fef2f2;
  --danger-border: #fecaca;
  
  --success: #16a34a;
  --success-light: #f0fdf4;
  --warning: #d97706;
  --warning-light: #fffbeb;
  
  --text-main: #0f172a;
  --text-muted: #64748b;
  --text-subtle: #94a3b8;
  
  --bg-page: #f8fafc;
  --bg-card: #ffffff;
  --border-color: #e2e8f0;
  --border-focus: #818cf8;
  
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --radius-full: 9999px;
  
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  --shadow-lg: 0 10px 25px -3px rgba(15, 23, 42, 0.08), 0 4px 6px -4px rgba(15, 23, 42, 0.03);
  --shadow-modal: 0 25px 50px -12px rgba(15, 23, 42, 0.25);
  
  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after {
  box-sizing: border-box;
}

/* Pastikan elemen dengan atribut hidden selalu disembunyikan sepenuhnya */
[hidden] {
  display: none !important;
}

body {
  margin: 0;
  font-family: var(--font-sans);
  background-color: var(--bg-page);
  color: var(--text-main);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Aksesibilitas Screen Reader Only */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ==========================================================================
   Header / Navbar
   ========================================================================== */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
  padding: 12px 0;
  transition: var(--transition);
}

.nav-content {
  width: min(100% - 32px, 720px);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--text-main);
  font-weight: 800;
  font-size: 20px;
  letter-spacing: -0.5px;
}

.brand-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #6366f1, #a855f7);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

.brand-text {
  background: linear-gradient(135deg, #4f46e5, #9333ea);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.nav-user-menu {
  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: var(--primary-light);
  color: var(--primary);
  border: 1px solid var(--primary-border);
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 13px;
  cursor: pointer;
  transition: var(--transition);
}

.nav-btn:hover {
  background: #e0e7ff;
}

.nav-btn-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 12px 4px 4px;
  background: white;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-full);
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  color: var(--text-main);
  transition: var(--transition);
}

.nav-btn-pill:hover {
  border-color: var(--border-focus);
}

.nav-username {
  max-width: 120px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-btn-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  border: 1px solid var(--border-color);
  background: white;
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: var(--transition);
}

.nav-btn-icon:hover {
  background: var(--danger-light);
  color: var(--danger);
  border-color: var(--danger-border);
}

.avatar-mini {
  width: 26px;
  height: 26px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==========================================================================
   Container & Card Dasar
   ========================================================================== */
.container {
  width: min(100% - 32px, 640px);
  margin: 28px auto 48px;
  flex: 1;
}

.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 24px;
  margin-bottom: 24px;
  transition: var(--transition);
}

.card:hover {
  box-shadow: var(--shadow-md);
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.card-heading h3 {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
}

.heading-icon {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ==========================================================================
   Panel Autentikasi (Modern Segmented Card)
   ========================================================================== */
.auth-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 36px 32px;
  max-width: 440px;
  margin: 40px auto;
}

.auth-header {
  text-align: center;
  margin-bottom: 24px;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--primary-light);
  color: var(--primary);
  font-size: 12px;
  font-weight: 600;
  padding: 4px 10px;
  border-radius: var(--radius-full);
  margin-bottom: 12px;
}

.dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--primary);
}

.auth-header h1 {
  margin: 0 0 6px;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.auth-desc {
  margin: 0;
  color: var(--text-muted);
  font-size: 14px;
}

.auth-tabs {
  display: flex;
  background: #f1f5f9;
  border-radius: var(--radius-md);
  padding: 4px;
  margin-bottom: 24px;
  gap: 4px;
}

.tab-btn {
  flex: 1;
  padding: 10px;
  border: 0;
  background: transparent;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 14px;
  color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition);
}

.tab-btn.active {
  background: white;
  color: var(--text-main);
  box-shadow: var(--shadow-sm);
}

.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--text-main);
}

.required {
  color: var(--danger);
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon, .input-svg {
  position: absolute;
  left: 14px;
  color: var(--text-subtle);
  pointer-events: none;
}

.input-icon {
  font-weight: 700;
  font-size: 15px;
}

input[type="text"],
input[type="email"],
input[type="password"],
textarea {
  width: 100%;
  font-family: inherit;
  font-size: 14px;
  padding: 12px 14px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  background: white;
  color: var(--text-main);
  transition: var(--transition);
}

.input-wrapper input {
  padding-left: 42px;
}

input:focus, textarea:focus {
  outline: none;
  border-color: var(--border-focus);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
}

.field-hint, .counter-text {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 5px;
}

.btn-text-link {
  background: none;
  border: none;
  color: var(--primary);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 20px;
  background: var(--primary);
  color: white;
  font-weight: 700;
  font-size: 14px;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: var(--transition);
}

.btn-primary:hover:not(:disabled) {
  background: var(--primary-hover);
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
}

.btn-primary:disabled, .btn-danger:disabled, .btn-secondary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-block {
  width: 100%;
  margin-top: 10px;
}

.auth-footer {
  text-align: center;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid var(--border-color);
}

.btn-text {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 13px;
  cursor: pointer;
}

.btn-text strong {
  color: var(--primary);
}

/* ==========================================================================
   Kartu Profil Pengguna
   ========================================================================== */
.profile-card {
  position: relative;
  overflow: hidden;
}

.profile-header {
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.avatar-large {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #6366f1, #a855f7);
  color: white;
  font-size: 28px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8px 16px rgba(99, 102, 241, 0.25);
}

.profile-info {
  flex: 1;
}

.profile-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.profile-username {
  margin: 0;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.badge-subtle {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  background: #f1f5f9;
  color: var(--text-muted);
  padding: 3px 8px;
  border-radius: var(--radius-full);
}

.profile-email {
  margin: 0 0 8px;
  font-size: 13px;
  color: var(--text-muted);
}

.profile-bio-display {
  margin: 0;
  font-size: 14px;
  color: #334155;
  white-space: pre-line;
}

.profile-control-row {
  display: flex;
  gap: 10px;
  margin-top: 18px;
  padding-top: 18px;
  border-top: 1px solid var(--border-color);
}

.btn-sm {
  padding: 8px 14px;
  font-size: 13px;
  border-radius: var(--radius-sm);
}

.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: white;
  border: 1px solid var(--border-color);
  color: var(--text-main);
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
}

.btn-outline:hover {
  background: #f8fafc;
  border-color: var(--border-focus);
}

.btn-danger-outline {
  background: white;
  border: 1px solid var(--danger-border);
  color: var(--danger);
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
}

.btn-danger-outline:hover {
  background: var(--danger-light);
}

.edit-profile-form {
  margin-top: 20px;
  padding: 18px;
  background: #f8fafc;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-color);
}

.form-actions-row {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 14px;
}

.btn-secondary {
  padding: 8px 16px;
  background: #e2e8f0;
  color: var(--text-main);
  border: none;
  border-radius: var(--radius-sm);
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
}

.btn-secondary:hover {
  background: #cbd5e1;
}

/* ==========================================================================
   Kartu Buat Postingan
   ========================================================================== */
.post-form textarea {
  min-height: 85px;
  resize: vertical;
}

.upload-zone {
  margin-bottom: 16px;
}

.file-input-hidden {
  display: none;
}

.file-input-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18px;
  background: #f8fafc;
  border: 2px dashed #cbd5e1;
  border-radius: var(--radius-md);
  cursor: pointer;
  color: var(--text-muted);
  text-align: center;
  transition: var(--transition);
}

.file-input-label:hover {
  background: var(--primary-light);
  border-color: var(--primary-border);
  color: var(--primary);
}

.upload-label-main {
  font-weight: 700;
  font-size: 14px;
  margin-top: 6px;
}

.upload-label-sub {
  font-size: 12px;
  color: var(--text-muted);
  margin-top: 2px;
}

.media-preview-box {
  background: #0f172a;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 16px;
}

.preview-media-container {
  display: flex;
  align-items: center;
  justify-content: center;
  max-height: 380px;
  background: #020617;
}

.preview-media {
  max-width: 100%;
  max-height: 380px;
  object-fit: contain;
  display: block;
}

.preview-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: rgba(255, 255, 255, 0.08);
  color: white;
  font-size: 13px;
}

.preview-filename {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 75%;
}

.btn-text-danger {
  background: none;
  border: none;
  color: #f87171;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
}

.btn-text-danger:hover {
  text-decoration: underline;
}

.upload-progress-box {
  margin-bottom: 16px;
}

.progress-bar-bg {
  height: 8px;
  background: #e2e8f0;
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 6px;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6366f1, #8b5cf6);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 12px;
  font-weight: 600;
  color: var(--primary);
}

.post-submit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn-text-subtle {
  background: none;
  border: none;
  color: var(--text-subtle);
  font-size: 13px;
  cursor: pointer;
}

.btn-text-subtle:hover {
  color: var(--text-muted);
  text-decoration: underline;
}

/* ==========================================================================
   Feed Postingan & Kartu Post
   ========================================================================== */
.feed-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18px;
}

.feed-title-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feed-heading h2 {
  margin: 0;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.5px;
}

.live-dot {
  width: 8px;
  height: 8px;
  background: var(--success);
  border-radius: 50%;
  box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(22, 163, 74, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
}

.muted-text {
  font-size: 13px;
  color: var(--text-muted);
}

.post-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 22px;
  overflow: hidden;
  transition: var(--transition);
}

.post-card:hover {
  box-shadow: var(--shadow-md);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
}

.post-author-box {
  display: flex;
  align-items: center;
  gap: 12px;
}

.post-author-name {
  font-weight: 700;
  font-size: 14px;
  color: var(--text-main);
}

.post-date {
  font-size: 12px;
  color: var(--text-subtle);
}

.post-media-container {
  background: #020617;
  max-height: 580px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-media {
  width: 100%;
  max-height: 580px;
  object-fit: contain;
  display: block;
}

.post-caption-box {
  padding: 16px 18px;
  font-size: 14px;
  line-height: 1.6;
  color: #1e293b;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.post-actions-row {
  display: flex;
  justify-content: flex-end;
  padding: 10px 18px;
  background: #f8fafc;
  border-top: 1px solid #f1f5f9;
}

.btn-delete-post {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: transparent;
  border: 1px solid var(--danger-border);
  color: var(--danger);
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
}

.btn-delete-post:hover {
  background: var(--danger-light);
}

/* ==========================================================================
   Skeleton Shimmer Loading & Empty State
   ========================================================================== */
.skeleton-card {
  background: white;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: 18px;
  margin-bottom: 20px;
}

.skeleton-header {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.skeleton-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #e2e8f0;
}

.skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeleton-line {
  height: 12px;
  border-radius: var(--radius-sm);
  background: #e2e8f0;
  position: relative;
  overflow: hidden;
}

.line-short { width: 40%; }
.line-tiny { width: 25%; }
.line-half { width: 60%; }

.skeleton-media {
  height: 240px;
  border-radius: var(--radius-md);
  background: #e2e8f0;
  margin-bottom: 16px;
}

.skeleton-avatar, .skeleton-line, .skeleton-media {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.empty-feed {
  text-align: center;
  padding: 48px 24px;
  background: white;
  border: 1px dashed var(--border-color);
  border-radius: var(--radius-lg);
}

.empty-icon-box {
  width: 72px;
  height: 72px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-feed h4 {
  margin: 0 0 6px;
  font-size: 18px;
  font-weight: 700;
}

.empty-feed p {
  margin: 0;
  color: var(--text-muted);
  font-size: 14px;
}

/* ==========================================================================
   Toast Notification Modern (Top Center)
   ========================================================================== */
.toast-container {
  position: fixed;
  top: 18px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10000;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
  width: min(calc(100vw - 32px), 440px);
}

.toast {
  pointer-events: auto;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  border-radius: var(--radius-md);
  background: white;
  box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.15), 0 8px 10px -6px rgba(15, 23, 42, 0.1);
  border-left: 4px solid;
  animation: toastSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transition: opacity 0.25s, transform 0.25s;
}

.toast.toast-hiding {
  opacity: 0;
  transform: translateY(-10px);
}

@keyframes toastSlideIn {
  from { opacity: 0; transform: translateY(-16px); }
  to { opacity: 1; transform: translateY(0); }
}

.toast-success { border-left-color: var(--success); }
.toast-error { border-left-color: var(--danger); }
.toast-warning { border-left-color: var(--warning); }
.toast-info { border-left-color: var(--primary); }

.toast-icon {
  flex-shrink: 0;
  margin-top: 1px;
}

.toast-success .toast-icon { color: var(--success); }
.toast-error .toast-icon { color: var(--danger); }
.toast-warning .toast-icon { color: var(--warning); }
.toast-info .toast-icon { color: var(--primary); }

.toast-content {
  flex: 1;
}

.toast-title {
  margin: 0 0 2px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-main);
}

.toast-msg {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.toast-close {
  background: none;
  border: none;
  color: var(--text-subtle);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  padding: 0;
  margin-left: 6px;
}

.toast-close:hover {
  color: var(--text-main);
}

/* ==========================================================================
   Modal Dialog Modern (Dukungan Animasi Fade In/Out, Backdrop Blur, & Aksesibilitas)
   ========================================================================== */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  overflow-y: auto;
  overscroll-behavior: contain;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.22s ease, visibility 0.22s ease;
}

/* Saat modal aktif / terbuka */
.modal-backdrop.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* Saat modal dalam proses animasi keluar */
.modal-backdrop.is-closing {
  opacity: 0;
  visibility: visible;
  pointer-events: none;
  transition: opacity 0.2s ease-in;
}

/* Pastikan modal-backdrop yang memiliki atribut hidden tidak tampil sama sekali */
.modal-backdrop[hidden] {
  display: none !important;
}

.modal-card {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35), 0 0 0 1px var(--border-color);
  width: 100%;
  max-width: 440px;
  max-height: calc(100vh - 32px);
  overflow-y: auto;
  padding: 24px;
  transform: scale(0.94) translateY(12px);
  opacity: 0;
  transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  position: relative;
  margin: auto;
}

.modal-backdrop.is-open .modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.modal-backdrop.is-closing .modal-card {
  transform: scale(0.95) translateY(10px);
  opacity: 0;
  transition: transform 0.2s cubic-bezier(0.4, 0, 1, 1), opacity 0.18s ease-in;
}

.modal-large {
  max-width: 560px;
}

.modal-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
  position: relative;
}

.modal-header h4 {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  flex: 1;
  color: var(--text-main);
}

.modal-icon-circle {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-info {
  background: var(--primary-light);
  color: var(--primary);
}

.icon-danger {
  background: var(--danger-light);
  color: var(--danger);
}

.modal-close-btn {
  background: transparent;
  border: none;
  font-size: 24px;
  line-height: 1;
  color: var(--text-subtle);
  cursor: pointer;
  padding: 6px;
  margin: -6px -6px -6px auto;
  min-width: 36px;
  min-height: 36px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: background-color var(--transition), color var(--transition);
}

.modal-close-btn:hover,
.modal-close-btn:focus-visible {
  color: var(--text-main);
  background-color: var(--bg-page);
  outline: none;
}

.modal-body {
  font-size: 14px;
  color: var(--text-muted);
  margin-bottom: 22px;
}

.modal-body p {
  margin: 0 0 10px;
  line-height: 1.5;
}

.danger-notice {
  background: var(--danger-light);
  border: 1px solid var(--danger-border);
  padding: 10px 14px;
  border-radius: var(--radius-md);
  color: #991b1b;
  font-size: 13px;
  margin-bottom: 16px;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  background: var(--danger);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: var(--transition);
}

.btn-danger:hover:not(:disabled) {
  background: var(--danger-hover);
}

.btn-danger:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Panduan Cloudinary */
.guide-steps {
  padding-left: 20px;
  margin: 12px 0;
  font-size: 13px;
  line-height: 1.7;
}

.code-preview {
  background: #0f172a;
  color: #f1f5f9;
  padding: 12px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  overflow-x: auto;
  margin: 8px 0;
}

/* Spinner */
.spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ==========================================================================
   Footer
   ========================================================================== */
.footer {
  margin-top: auto;
  border-top: 1px solid var(--border-color);
  background: white;
  padding: 24px 0;
  text-align: center;
  font-size: 13px;
  color: var(--text-muted);
}

/* ==========================================================================
   Responsif Smartphone & Tablet
   ========================================================================== */
@media (max-width: 640px) {
  .nav-btn-text {
    display: none;
  }
  
  .container {
    margin-top: 16px;
  }
  
  .card, .auth-card {
    padding: 20px;
    border-radius: var(--radius-md);
  }
  
  .profile-header {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .profile-title-row {
    justify-content: center;
  }
  
  .profile-control-row {
    justify-content: center;
  }
  
  .modal-card {
    padding: 20px;
  }
}

/* Hormati Preferensi Pengguna yang Mengurangi Animasi */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}