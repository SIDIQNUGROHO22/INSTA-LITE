/* ==========================================================================
   InstaLite — Modern Liquid Glass UI (iOS Inspired Design System)
   ========================================================================== */

:root {
  /* 1. Color System: Electric Blue, Lavender & Soft Violet */
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --primary-active: #1e40af;
  --primary-light: rgba(37, 99, 235, 0.08);
  --primary-border: rgba(147, 197, 253, 0.55);
  --primary-gradient: linear-gradient(135deg, #3b82f6 0%, #2563eb 55%, #1d4ed8 100%);
  --primary-glow: rgba(37, 99, 235, 0.32);

  --secondary: #8b5cf6;
  --secondary-hover: #7c3aed;
  --secondary-light: rgba(139, 92, 246, 0.1);
  --secondary-border: rgba(196, 181, 253, 0.55);
  --secondary-gradient: linear-gradient(135deg, #a855f7 0%, #8b5cf6 55%, #6366f1 100%);

  --liquid-mesh-accent: #6366f1;
  --accent-pink: #ec4899;

  /* State Colors */
  --danger: #ef4444;
  --danger-hover: #dc2626;
  --danger-light: rgba(239, 68, 68, 0.09);
  --danger-border: rgba(254, 202, 202, 0.7);
  --danger-gradient: linear-gradient(135deg, #f87171 0%, #ef4444 55%, #dc2626 100%);

  --success: #10b981;
  --success-light: rgba(16, 185, 129, 0.1);
  --warning: #f59e0b;
  --warning-light: rgba(245, 158, 11, 0.1);

  /* Typography: Dark Navy for Primary, Slate Blue for Secondary (No pale gray) */
  --text-main: #0f172a;       /* Deep navy */
  --text-muted: #334155;      /* Slate navy - sharp & high contrast */
  --text-subtle: #475569;     /* Legible slate */
  --text-inverse: #ffffff;

  /* Liquid Glass Surfaces */
  --glass-surface: rgba(255, 255, 255, 0.75);
  --glass-surface-hover: rgba(255, 255, 255, 0.88);
  --glass-surface-solid: rgba(255, 255, 255, 0.94);
  --glass-border: rgba(255, 255, 255, 0.75);
  --glass-border-subtle: rgba(226, 232, 240, 0.65);
  --glass-border-highlight: rgba(255, 255, 255, 0.95);
  
  --border-color: rgba(226, 232, 240, 0.6);
  --border-focus: #3b82f6;

  /* Radius & Curves (iOS Smooth Squircle Feel) */
  --radius-xs: 6px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-xl: 24px;
  --radius-full: 9999px;

  /* Shadows: Diffuse Liquid Shadows with Inner Specular Sheen */
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  --shadow-md: 0 10px 25px -4px rgba(30, 41, 59, 0.06), 0 4px 10px -2px rgba(30, 41, 59, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.95);
  --shadow-lg: 0 20px 45px -8px rgba(30, 41, 59, 0.09), 0 8px 16px -2px rgba(30, 41, 59, 0.04), inset 0 1px 0 rgba(255, 255, 255, 1);
  --shadow-card-hover: 0 24px 50px -10px rgba(99, 102, 241, 0.13), 0 8px 18px -2px rgba(30, 41, 59, 0.04), inset 0 1px 0 rgba(255, 255, 255, 1);
  --shadow-modal: 0 30px 65px -12px rgba(15, 23, 42, 0.28), inset 0 1px 0 rgba(255, 255, 255, 1);

  /* Typography & Transitions */
  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-fast: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after {
  box-sizing: border-box;
}

/* Aksesibilitas: Elemen hidden selalu disembunyikan */
[hidden] {
  display: none !important;
}

/* ==========================================================================
   2. Background Redesign: Ambient Blue-Lavender Liquid Gradient
   ========================================================================== */
body {
  margin: 0;
  font-family: var(--font-sans);
  background: 
    radial-gradient(circle at 8% 12%, rgba(99, 102, 241, 0.15) 0%, transparent 45%),
    radial-gradient(circle at 90% 8%, rgba(168, 85, 247, 0.14) 0%, transparent 42%),
    radial-gradient(circle at 50% 50%, rgba(59, 130, 246, 0.09) 0%, transparent 50%),
    radial-gradient(circle at 82% 88%, rgba(139, 92, 246, 0.13) 0%, transparent 45%),
    radial-gradient(circle at 14% 92%, rgba(56, 189, 248, 0.13) 0%, transparent 45%),
    linear-gradient(160deg, #f0f4ff 0%, #f6f3ff 45%, #eff6ff 100%);
  background-attachment: fixed;
  color: var(--text-main);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-x: hidden;
}

/* Ambient Glowing Orbs Dekoratif (Fixed & Hardware Accelerated) */
body::before,
body::after {
  content: "";
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
  filter: blur(85px);
  opacity: 0.65;
  transform: translateZ(0);
}

body::before {
  width: 480px;
  height: 480px;
  top: -120px;
  left: -80px;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.28) 0%, rgba(59, 130, 246, 0.14) 60%, transparent 80%);
}

body::after {
  width: 520px;
  height: 520px;
  bottom: -120px;
  right: -80px;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.24) 0%, rgba(139, 92, 246, 0.12) 60%, transparent 80%);
}

/* Aksesibilitas Screen Reader Only */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* ==========================================================================
   3. Header / Navbar Liquid Glass
   ========================================================================== */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.74);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border-bottom: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4px 20px -2px rgba(30, 41, 59, 0.04), inset 0 -1px 0 rgba(226, 232, 240, 0.4);
  padding: 12px 0;
  transition: var(--transition);
}

.nav-content {
  width: min(100% - 32px, 720px);
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--text-main);
  font-weight: 800;
  font-size: 20px;
  letter-spacing: -0.5px;
  transition: var(--transition);
}

.brand:hover {
  transform: translateY(-1px);
}

.brand-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #2563eb, #8b5cf6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  border: 1px solid rgba(255, 255, 255, 0.35);
  transition: var(--transition);
}

.brand:hover .brand-icon {
  box-shadow: 0 8px 22px rgba(37, 99, 235, 0.45);
  transform: scale(1.04);
}

.brand-text {
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 40%, #7c3aed 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 800;
}

.nav-user-menu {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Nav Button: Posting */
.nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(139, 92, 246, 0.12));
  color: #1d4ed8;
  border: 1px solid rgba(147, 197, 253, 0.7);
  border-radius: var(--radius-full);
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: var(--transition);
}

.nav-btn:hover {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: white;
  border-color: transparent;
  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);
  transform: translateY(-1.5px);
}

.nav-btn:active {
  transform: translateY(0.5px) scale(0.98);
}

/* Nav Button: Pill Pengguna */
.nav-btn-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 14px 4px 4px;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-full);
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  color: var(--text-main);
  box-shadow: 0 2px 8px rgba(30, 41, 59, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: var(--transition);
}

.nav-btn-pill:hover {
  background: rgba(255, 255, 255, 0.95);
  border-color: rgba(99, 102, 241, 0.4);
  color: #1d4ed8;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.12);
  transform: translateY(-1px);
}

.nav-btn-pill:active {
  transform: translateY(0.5px) scale(0.98);
}

.nav-username {
  max-width: 120px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Nav Button: Icon Logout */
.nav-btn-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: var(--text-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(30, 41, 59, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: var(--transition);
}

.nav-btn-icon:hover {
  background: rgba(254, 242, 242, 0.9);
  color: var(--danger);
  border-color: rgba(254, 202, 202, 0.8);
  box-shadow: 0 4px 12px rgba(239, 68, 68, 0.18);
  transform: translateY(-1px);
}

.nav-btn-icon:active {
  transform: translateY(0.5px) scale(0.96);
}

.avatar-mini {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #2563eb, #8b5cf6);
  color: white;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

/* ==========================================================================
   4. Container & Liquid Glass Cards
   ========================================================================== */
.container {
  width: min(100% - 32px, 640px);
  margin: 28px auto 48px;
  flex: 1;
}

.card {
  background: var(--glass-surface);
  backdrop-filter: blur(24px) saturate(180%);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  padding: 26px;
  margin-bottom: 24px;
  transition: var(--transition);
}

.card:hover {
  background: var(--glass-surface-hover);
  border-color: var(--glass-border-highlight);
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-2px);
}

.card-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.card-heading h3 {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-main);
  letter-spacing: -0.3px;
}

.heading-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.14), rgba(139, 92, 246, 0.14));
  color: var(--primary);
  border: 1px solid rgba(147, 197, 253, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

/* ==========================================================================
   5. Panel Autentikasi (Modern Segmented Glass Card)
   ========================================================================== */
.auth-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(28px) saturate(190%);
  -webkit-backdrop-filter: blur(28px) saturate(190%);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  padding: 38px 34px;
  max-width: 440px;
  margin: 40px auto;
  transition: var(--transition);
}

.auth-header {
  text-align: center;
  margin-bottom: 26px;
}

.auth-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(37, 99, 235, 0.08);
  color: #1d4ed8;
  font-size: 12px;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: var(--radius-full);
  border: 1px solid rgba(147, 197, 253, 0.6);
  margin-bottom: 14px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25);
}

.auth-header h1 {
  margin: 0 0 8px;
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.6px;
  color: var(--text-main);
}

.auth-desc {
  margin: 0;
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 500;
}

/* Segmented Tab: Masuk vs Daftar */
.auth-tabs {
  display: flex;
  background: rgba(226, 232, 240, 0.55);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: var(--radius-md);
  padding: 4px;
  margin-bottom: 24px;
  gap: 4px;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05);
}

.tab-btn {
  flex: 1;
  padding: 10px;
  border: 0;
  background: transparent;
  border-radius: var(--radius-sm);
  font-weight: 600;
  font-size: 14px;
  color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition);
}

.tab-btn:hover:not(.active) {
  color: var(--text-main);
  background: rgba(255, 255, 255, 0.35);
}

.tab-btn.active {
  background: rgba(255, 255, 255, 0.94);
  color: #1d4ed8;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(30, 41, 59, 0.08), inset 0 1px 0 rgba(255, 255, 255, 1);
  border: 1px solid rgba(255, 255, 255, 0.9);
}

/* Form Groups & Inputs */
.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 6px;
  color: var(--text-main);
}

.required {
  color: var(--danger);
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon, .input-svg {
  position: absolute;
  left: 14px;
  color: var(--text-subtle);
  pointer-events: none;
  transition: var(--transition);
}

.input-icon {
  font-weight: 700;
  font-size: 15px;
}

input[type="text"],
input[type="email"],
input[type="password"],
textarea {
  width: 100%;
  font-family: inherit;
  font-size: 14px;
  padding: 12px 14px;
  border: 1px solid rgba(203, 213, 225, 0.75);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  color: var(--text-main);
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03);
  transition: var(--transition);
}

.input-wrapper input {
  padding-left: 42px;
}

input:focus, textarea:focus {
  outline: none;
  background: rgba(255, 255, 255, 0.96);
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.22), 0 2px 8px rgba(37, 99, 235, 0.08);
}

input:focus + .input-svg,
.input-wrapper:focus-within .input-svg,
.input-wrapper:focus-within .input-icon {
  color: var(--primary);
}

.field-hint, .counter-text {
  font-size: 12px;
  color: var(--text-subtle);
  margin-top: 5px;
  font-weight: 500;
}

/* ==========================================================================
   6. Liquid Glass Button System
   ========================================================================== */

/* Primary Button (Electric Blue Liquid Glass) */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 22px;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 55%, #1d4ed8 100%);
  color: #ffffff;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.01em;
  border: 1px solid rgba(255, 255, 255, 0.32);
  border-radius: var(--radius-md);
  cursor: pointer;
  box-shadow: 0 8px 22px -4px rgba(37, 99, 235, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.38);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}

.btn-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 50%, #2563eb 100%);
  box-shadow: 0 12px 28px -4px rgba(37, 99, 235, 0.52), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  transform: translateY(-1.5px);
}

.btn-primary:active:not(:disabled) {
  transform: translateY(0.5px) scale(0.985);
  box-shadow: 0 4px 12px -2px rgba(37, 99, 235, 0.35);
}

/* Secondary Button (Frosted White Glass) */
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  color: #1e293b;
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(30, 41, 59, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.95);
  transition: var(--transition);
}

.btn-secondary:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(199, 210, 254, 0.8);
  color: #0f172a;
  box-shadow: 0 6px 18px rgba(30, 41, 59, 0.09), inset 0 1px 0 rgba(255, 255, 255, 1);
  transform: translateY(-1.5px);
}

.btn-secondary:active:not(:disabled) {
  transform: translateY(0.5px) scale(0.985);
}

/* Outline Button (Subtle Frosted Pill) */
.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.85);
  color: #1e293b;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(30, 41, 59, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: var(--transition);
}

.btn-outline:hover {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(99, 102, 241, 0.45);
  color: #2563eb;
  box-shadow: 0 4px 14px rgba(99, 102, 241, 0.15);
  transform: translateY(-1.5px);
}

.btn-outline:active {
  transform: translateY(0.5px) scale(0.985);
}

/* Danger Button (Liquid Coral/Ruby Glass) */
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  background: linear-gradient(135deg, #f87171 0%, #ef4444 55%, #dc2626 100%);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-md);
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  box-shadow: 0 8px 20px -4px rgba(239, 68, 68, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  transition: var(--transition);
}

.btn-danger:hover:not(:disabled) {
  background: linear-gradient(135deg, #fca5a5 0%, #f87171 50%, #ef4444 100%);
  box-shadow: 0 12px 26px -4px rgba(239, 68, 68, 0.48);
  transform: translateY(-1.5px);
}

.btn-danger:active:not(:disabled) {
  transform: translateY(0.5px) scale(0.985);
}

/* Danger Outline Button */
.btn-danger-outline {
  display: inline-flex;
  align-items: center;
  background: rgba(254, 242, 242, 0.72);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(254, 202, 202, 0.8);
  color: #dc2626;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(239, 68, 68, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: var(--transition);
}

.btn-danger-outline:hover {
  background: rgba(254, 226, 226, 0.94);
  border-color: rgba(239, 68, 68, 0.5);
  color: #b91c1c;
  box-shadow: 0 4px 14px rgba(239, 68, 68, 0.16);
  transform: translateY(-1.5px);
}

.btn-danger-outline:active {
  transform: translateY(0.5px) scale(0.985);
}

/* Tombol Hapus Post */
.btn-delete-post {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(254, 202, 202, 0.75);
  color: #dc2626;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 1px 4px rgba(239, 68, 68, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition: var(--transition);
}

.btn-delete-post:hover {
  background: rgba(254, 226, 226, 0.92);
  border-color: rgba(239, 68, 68, 0.45);
  color: #b91c1c;
  transform: translateY(-1px);
  box-shadow: 0 3px 10px rgba(239, 68, 68, 0.15);
}

.btn-delete-post:active {
  transform: translateY(0.5px) scale(0.98);
}

/* State Disabled Global untuk Tombol */
.btn-primary:disabled,
.btn-secondary:disabled,
.btn-danger:disabled,
.btn-outline:disabled {
  opacity: 0.55;
  cursor: not-allowed !important;
  transform: none !important;
  box-shadow: none !important;
  filter: grayscale(20%);
  pointer-events: none;
}

.btn-block {
  width: 100%;
  margin-top: 10px;
}

.btn-sm {
  padding: 8px 14px;
  font-size: 13px;
  border-radius: var(--radius-sm);
}

/* Text Buttons */
.btn-text-link {
  background: none;
  border: none;
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  padding: 0;
  transition: var(--transition);
}

.btn-text-link:hover {
  color: var(--primary-hover);
  text-decoration: underline;
}

.auth-footer {
  text-align: center;
  margin-top: 22px;
  padding-top: 20px;
  border-top: 1px solid rgba(226, 232, 240, 0.7);
}

.btn-text {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 13px;
  cursor: pointer;
  transition: var(--transition);
}

.btn-text:hover {
  color: var(--text-main);
}

.btn-text strong {
  color: #2563eb;
  font-weight: 700;
}

.btn-text-subtle {
  background: none;
  border: none;
  color: var(--text-subtle);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition);
}

.btn-text-subtle:hover {
  color: var(--primary);
  text-decoration: underline;
}

.btn-text-danger {
  background: none;
  border: none;
  color: #ef4444;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
  transition: var(--transition);
}

.btn-text-danger:hover {
  color: #dc2626;
  text-decoration: underline;
}

/* ==========================================================================
   7. Kartu Profil Pengguna
   ========================================================================== */
.profile-card {
  position: relative;
  overflow: hidden;
}

.profile-header {
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.avatar-large {
  width: 72px;
  height: 72px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #2563eb 0%, #8b5cf6 100%);
  color: white;
  font-size: 28px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.32), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  border: 2px solid rgba(255, 255, 255, 0.5);
}

.profile-info {
  flex: 1;
}

.profile-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 4px;
}

.profile-username {
  margin: 0;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--text-main);
}

.badge-subtle {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  background: rgba(37, 99, 235, 0.08);
  color: #1d4ed8;
  border: 1px solid rgba(147, 197, 253, 0.55);
  padding: 3px 10px;
  border-radius: var(--radius-full);
}

.profile-email {
  margin: 0 0 8px;
  font-size: 13px;
  color: var(--text-subtle);
  font-weight: 500;
}

.profile-bio-display {
  margin: 0;
  font-size: 14px;
  color: var(--text-muted);
  white-space: pre-line;
  line-height: 1.5;
}

.profile-control-row {
  display: flex;
  gap: 10px;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid rgba(226, 232, 240, 0.7);
}

.edit-profile-form {
  margin-top: 20px;
  padding: 18px;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: var(--radius-md);
  border: 1px solid rgba(255, 255, 255, 0.8);
}

.form-actions-row {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 14px;
}

/* ==========================================================================
   8. Kartu Buat Postingan
   ========================================================================== */
.post-form textarea {
  min-height: 90px;
  resize: vertical;
}

.upload-zone {
  margin-bottom: 16px;
}

.file-input-hidden {
  display: none;
}

.file-input-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22px 18px;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 2px dashed rgba(147, 197, 253, 0.7);
  border-radius: var(--radius-md);
  cursor: pointer;
  color: var(--text-muted);
  text-align: center;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.02);
  transition: var(--transition);
}

.file-input-label:hover {
  background: rgba(238, 242, 255, 0.75);
  border-color: #3b82f6;
  color: var(--primary);
  transform: translateY(-1px);
}

.upload-label-main {
  font-weight: 700;
  font-size: 14px;
  margin-top: 8px;
}

.upload-label-sub {
  font-size: 12px;
  color: var(--text-subtle);
  margin-top: 3px;
}

.media-preview-box {
  background: #0f172a;
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: 16px;
  box-shadow: var(--shadow-md);
}

.preview-media-container {
  display: flex;
  align-items: center;
  justify-content: center;
  max-height: 380px;
  background: #020617;
}

.preview-media {
  max-width: 100%;
  max-height: 380px;
  object-fit: contain;
  display: block;
}

.preview-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 14px;
  background: rgba(255, 255, 255, 0.08);
  color: white;
  font-size: 13px;
}

.preview-filename {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 75%;
}

.upload-progress-box {
  margin-bottom: 16px;
}

.progress-bar-bg {
  height: 8px;
  background: rgba(226, 232, 240, 0.7);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-bottom: 6px;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6, #8b5cf6);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
}

.post-submit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ==========================================================================
   9. Feed Postingan & Kartu Post Liquid Glass
   ========================================================================== */
.feed-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20px;
}

.feed-title-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
}

.feed-heading h2 {
  margin: 0;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--text-main);
}

.live-dot {
  width: 8px;
  height: 8px;
  background: var(--success);
  border-radius: 50%;
  box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
  70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.muted-text {
  font-size: 13px;
  color: var(--text-subtle);
  font-weight: 500;
}

.post-card {
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(22px) saturate(180%);
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  margin-bottom: 24px;
  overflow: hidden;
  transition: var(--transition);
}

.post-card:hover {
  background: rgba(255, 255, 255, 0.86);
  border-color: rgba(255, 255, 255, 0.9);
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-2px);
}

.post-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
}

.post-author-box {
  display: flex;
  align-items: center;
  gap: 12px;
}

.post-author-name {
  font-weight: 700;
  font-size: 14px;
  color: var(--text-main);
}

.post-date {
  font-size: 12px;
  color: var(--text-subtle);
  font-weight: 500;
}

.post-media-container {
  background: #020617;
  max-height: 580px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-media {
  width: 100%;
  max-height: 580px;
  object-fit: contain;
  display: block;
}

.post-caption-box {
  padding: 16px 20px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-muted);
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.post-actions-row {
  display: flex;
  justify-content: flex-end;
  padding: 10px 20px;
  background: rgba(248, 250, 252, 0.65);
  border-top: 1px solid rgba(226, 232, 240, 0.6);
}

/* Skeleton Shimmer Loading */
.skeleton-card {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: var(--radius-xl);
  padding: 20px;
  margin-bottom: 20px;
}

.skeleton-header {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.skeleton-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(226, 232, 240, 0.7);
}

.skeleton-lines {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.skeleton-line {
  height: 12px;
  border-radius: var(--radius-sm);
  background: rgba(226, 232, 240, 0.7);
  position: relative;
  overflow: hidden;
}

.line-short { width: 40%; }
.line-tiny { width: 25%; }
.line-half { width: 60%; }

.skeleton-media {
  height: 240px;
  border-radius: var(--radius-md);
  background: rgba(226, 232, 240, 0.7);
  margin-bottom: 16px;
}

.skeleton-avatar, .skeleton-line, .skeleton-media {
  background: linear-gradient(90deg, rgba(241, 245, 249, 0.6) 25%, rgba(226, 232, 240, 0.8) 50%, rgba(241, 245, 249, 0.6) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* Empty State */
.empty-feed {
  text-align: center;
  padding: 52px 24px;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 2px dashed rgba(203, 213, 225, 0.8);
  border-radius: var(--radius-xl);
}

.empty-icon-box {
  width: 72px;
  height: 72px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.12), rgba(139, 92, 246, 0.12));
  color: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.empty-feed h4 {
  margin: 0 0 6px;
  font-size: 19px;
  font-weight: 700;
  color: var(--text-main);
}

.empty-feed p {
  margin: 0;
  color: var(--text-muted);
  font-size: 14px;
}

/* ==========================================================================
   10. Toast Notification Modern Liquid Glass (Top Center)
   ========================================================================== */
.toast-container {
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10000;
  display: flex;
  flex-direction: column;
  gap: 10px;
  pointer-events: none;
  width: min(calc(100vw - 32px), 440px);
}

.toast {
  pointer-events: auto;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 18px;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  box-shadow: 0 16px 36px -5px rgba(15, 23, 42, 0.15), 0 4px 10px -2px rgba(15, 23, 42, 0.05), inset 0 1px 0 rgba(255, 255, 255, 1);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-left: 4px solid;
  animation: toastSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transition: opacity 0.25s, transform 0.25s;
}

.toast.toast-hiding {
  opacity: 0;
  transform: translateY(-10px);
}

@keyframes toastSlideIn {
  from { opacity: 0; transform: translateY(-16px); }
  to { opacity: 1; transform: translateY(0); }
}

.toast-success { border-left-color: var(--success); }
.toast-error { border-left-color: var(--danger); }
.toast-warning { border-left-color: var(--warning); }
.toast-info { border-left-color: var(--primary); }

.toast-icon {
  flex-shrink: 0;
  margin-top: 1px;
}

.toast-success .toast-icon { color: var(--success); }
.toast-error .toast-icon { color: var(--danger); }
.toast-warning .toast-icon { color: var(--warning); }
.toast-info .toast-icon { color: var(--primary); }

.toast-content {
  flex: 1;
}

.toast-title {
  margin: 0 0 2px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-main);
}

.toast-msg {
  margin: 0;
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.toast-close {
  background: none;
  border: none;
  color: var(--text-subtle);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
  padding: 0;
  margin-left: 6px;
  transition: var(--transition);
}

.toast-close:hover {
  color: var(--text-main);
}

/* ==========================================================================
   11. Modal Dialog Liquid Glass (Animasi Halus & Aksesibilitas Terjaga)
   ========================================================================== */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.52);
  backdrop-filter: blur(16px) saturate(160%);
  -webkit-backdrop-filter: blur(16px) saturate(160%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  overflow-y: auto;
  overscroll-behavior: contain;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s ease;
}

/* Saat modal aktif / terbuka */
.modal-backdrop.is-open {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* Saat modal dalam proses animasi keluar */
.modal-backdrop.is-closing {
  opacity: 0;
  visibility: visible;
  pointer-events: none;
  transition: opacity 0.2s ease-in;
}

/* Pastikan modal-backdrop dengan hidden tertutup sepenuhnya */
.modal-backdrop[hidden] {
  display: none !important;
}

.modal-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(30px) saturate(190%);
  -webkit-backdrop-filter: blur(30px) saturate(190%);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-modal);
  border: 1px solid rgba(255, 255, 255, 0.85);
  width: 100%;
  max-width: 440px;
  max-height: calc(100vh - 32px);
  overflow-y: auto;
  padding: 28px;
  transform: scale(0.94) translateY(12px);
  opacity: 0;
  transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  position: relative;
  margin: auto;
}

.modal-backdrop.is-open .modal-card {
  transform: scale(1) translateY(0);
  opacity: 1;
}

.modal-backdrop.is-closing .modal-card {
  transform: scale(0.95) translateY(10px);
  opacity: 0;
  transition: transform 0.2s cubic-bezier(0.4, 0, 1, 1), opacity 0.18s ease-in;
}

.modal-large {
  max-width: 560px;
}

.modal-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
  position: relative;
}

.modal-header h4 {
  margin: 0;
  font-size: 19px;
  font-weight: 700;
  flex: 1;
  color: var(--text-main);
  letter-spacing: -0.3px;
}

.modal-icon-circle {
  width: 42px;
  height: 42px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.icon-info {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.15), rgba(139, 92, 246, 0.15));
  color: var(--primary);
  border: 1px solid rgba(147, 197, 253, 0.5);
}

.icon-danger {
  background: rgba(254, 242, 242, 0.9);
  color: var(--danger);
  border: 1px solid rgba(254, 202, 202, 0.8);
}

.modal-close-btn {
  background: rgba(255, 255, 255, 0.6);
  border: 1px solid rgba(226, 232, 240, 0.6);
  font-size: 20px;
  line-height: 1;
  color: var(--text-subtle);
  cursor: pointer;
  padding: 6px;
  margin: -6px -6px -6px auto;
  min-width: 34px;
  min-height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  transition: var(--transition);
}

.modal-close-btn:hover,
.modal-close-btn:focus-visible {
  color: var(--text-main);
  background-color: rgba(255, 255, 255, 0.95);
  border-color: rgba(99, 102, 241, 0.4);
  transform: scale(1.05);
  outline: none;
}

.modal-body {
  font-size: 14px;
  color: var(--text-muted);
  margin-bottom: 24px;
}

.modal-body p {
  margin: 0 0 10px;
  line-height: 1.5;
}

.danger-notice {
  background: rgba(254, 242, 242, 0.85);
  border: 1px solid rgba(254, 202, 202, 0.9);
  padding: 12px 14px;
  border-radius: var(--radius-md);
  color: #991b1b;
  font-size: 13px;
  margin-bottom: 16px;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* Panduan Cloudinary */
.guide-steps {
  padding-left: 20px;
  margin: 14px 0;
  line-height: 1.6;
}

.guide-steps li {
  margin-bottom: 8px;
}

.code-preview {
  background: #0f172a;
  color: #f1f5f9;
  padding: 12px 14px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  margin: 8px 0;
  overflow-x: auto;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.code-preview code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.hint {
  font-size: 12px;
  color: var(--text-subtle);
  font-style: italic;
  margin-top: 12px;
}

/* Spinner */
.spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ==========================================================================
   12. Footer
   ========================================================================== */
.footer {
  margin-top: auto;
  border-top: 1px solid rgba(255, 255, 255, 0.65);
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  padding: 24px 0;
  text-align: center;
  font-size: 13px;
  color: var(--text-subtle);
  font-weight: 500;
}

/* ==========================================================================
   13. Responsif Smartphone & Tablet
   ========================================================================== */
@media (max-width: 640px) {
  .nav-btn-text {
    display: none;
  }
  
  .container {
    margin-top: 16px;
  }
  
  .card, .auth-card {
    padding: 22px 18px;
    border-radius: var(--radius-lg);
  }
  
  .profile-header {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  
  .profile-title-row {
    justify-content: center;
  }
  
  .profile-control-row {
    justify-content: center;
  }
  
  .modal-card {
    padding: 22px 18px;
    border-radius: var(--radius-lg);
  }
}

/* Hormati Preferensi Pengguna yang Mengurangi Animasi */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
  
  .modal-backdrop,
  .modal-backdrop.is-closing,
  .modal-card,
  .modal-backdrop.is-closing .modal-card {
    transition: none !important;
    animation: none !important;
  }
}