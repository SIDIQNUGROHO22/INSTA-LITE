rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (matches Firebase Auth UID)
    // Fields:
    //   - email: string (required, immutable, == request.auth.token.email, 1..320 chars)
    //   - username: string (required, matches ^[a-zA-Z0-9_.]{3,30}$)
    //   - bio: string (required, <= 500 chars)
    //   - photoURL: string (optional, '' OR Cloudinary image URL <= 1000 chars OR compressed raster Data URL <= 85000 chars)
    //   - photoPublicId: string (optional, <= 200 chars)
    //   - createdAt: timestamp (required, immutable)
    //
    // Subcollection: users/{uid}/bookmarks/{postId}
    // Document ID: {postId}
    // Fields:
    //   - postId: string (required, == document ID, 1..128 chars)
    //   - createdAt: timestamp (required)
    //
    // Subcollection: users/{uid}/hiddenPosts/{postId}
    // Document ID: {postId}
    // Fields:
    //   - postId: string (required, == document ID, 1..128 chars)
    //   - createdAt: timestamp (required)
    //
    // Subcollection: users/{uid}/following/{targetUid}
    // Document ID: {targetUid} (UID of followed user, != uid)
    // Fields:
    //   - targetUid: string (required, == targetUid, 1..128 chars)
    //   - createdAt: timestamp (required)
    //
    // Subcollection: users/{uid}/followers/{followerUid}
    // Document ID: {followerUid} (UID of follower user, != uid)
    // Fields:
    //   - uid: string (required, == followerUid, 1..128 chars)
    //   - createdAt: timestamp (required)
    //
    // Collection: posts
    // Document ID: {postId} (auto-generated)
    // Fields:
    //   - uid: string (required, immutable, == request.auth.uid on create)
    //   - username: string (required, matches ^[a-zA-Z0-9_.]{3,30}$ and equals users/{uid}.username)
    //   - caption: string (required, immutable, <= 2200 chars)
    //   - mediaUrl: string (required, immutable; '' for text, Cloudinary URL <= 1000 for image/video, or compressed raster Data URL <= 700000 for image fallback)
    //   - mediaPath: string (required, immutable, '' on create)
    //   - mediaPublicId: string (required, immutable; '' for text/Data URL fallback, 1..200 chars for Cloudinary)
    //   - mediaType: string (required, immutable, in ['text', 'image', 'video'])
    //   - createdAt: timestamp (required, immutable)
    //
    // Subcollection: posts/{postId}/likes/{uid}
    // Document ID: {uid} (matches liker Auth UID)
    // Fields:
    //   - uid: string (required, immutable, == request.auth.uid)
    //   - createdAt: timestamp (required)
    //
    // Subcollection: posts/{postId}/comments/{commentId}
    // Document ID: {commentId} (auto-generated)
    // Fields:
    //   - uid: string (required, immutable, == request.auth.uid)
    //   - username: string (required, matches ^[a-zA-Z0-9_.]{3,30}$)
    //   - photoURL: string (required, '' OR Cloudinary image URL <= 1000 chars OR compressed raster Data URL <= 85000 chars)
    //   - text: string (required, 1..500 chars)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: notifications
    // Document ID: {notificationId} (auto-generated)
    // Fields:
    //   - recipientUid: string (required, immutable, 1..128 chars, != request.auth.uid on create)
    //   - senderUid: string (required, immutable, == request.auth.uid on create, 1..128 chars)
    //   - senderUsername: string (required, immutable, matches ^[a-zA-Z0-9_.]{3,30}$)
    //   - type: string (required, immutable, in ['like', 'comment', 'mention', 'follow'])
    //   - postId: string (required, immutable, <= 128 chars)
    //   - commentId: string (required, immutable, <= 128 chars)
    //   - message: string (required, immutable, <= 500 chars)
    //   - read: bool (required, false on create; recipient may update)
    //   - createdAt: timestamp (required, immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Cek apakah pengguna telah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Cek apakah pengguna adalah pemilik dokumen berdasarkan UID pada path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Pastikan field uid belum dimanipulasi saat pembuatan dokumen
    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    // Pastikan field uid tidak berubah saat pembaruan dokumen
    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    // Validasi seluruh field wajib tersedia pada data dokumen
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validasi dokumen tidak mengandung field tambahan di luar skema
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Pastikan field immutable tidak dimodifikasi pada operasi update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Validasi format username standar (3-30 karakter: huruf, angka, titik, underscore)
    function isValidUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 30
        && username.matches('^[a-zA-Z0-9_.]{3,30}$');
    }

    // Validasi URL gambar HTTPS Cloudinary (maksimal 1000 karakter)
    function isValidCloudinaryImageUrl(url) {
      return url is string
        && url.size() <= 1000
        && url.matches('^https://res\\.cloudinary\\.com/.*/image/upload/.*');
    }

    // Validasi URL video HTTPS Cloudinary (maksimal 1000 karakter)
    function isValidCloudinaryVideoUrl(url) {
      return url is string
        && url.size() <= 1000
        && url.matches('^https://res\\.cloudinary\\.com/.*/video/upload/.*');
    }

    // Validasi Data URL gambar raster terkompresi (O(1) prefix slicing agar aman dari batas RE2 Firestore; blokir SVG/XSS)
    function isValidCompressedImageDataUrl(url, maxSize) {
      return url is string
        && url.size() > 23
        && url.size() <= maxSize
        && (
          url[0:23] == 'data:image/jpeg;base64,'
          || url[0:23] == 'data:image/webp;base64,'
          || url[0:22] == 'data:image/png;base64,'
        );
    }

    // Validasi URL avatar pengguna/komentar (string kosong, Cloudinary image, atau Data URL <= 85000)
    function isValidAvatarUrl(url) {
      return url is string && (
        url == ''
        || isValidCloudinaryImageUrl(url)
        || isValidCompressedImageDataUrl(url, 85000)
      );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasRequiredFields(data, ['email', 'username', 'bio', 'createdAt'])
        && hasOnlyAllowedFields(data, ['email', 'username', 'bio', 'createdAt', 'photoURL', 'photoPublicId'])
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && isValidUsername(data.username)
        && data.bio is string
        && data.bio.size() <= 500
        && (!('photoURL' in data) || isValidAvatarUrl(data.photoURL))
        && (!('photoPublicId' in data) || (data.photoPublicId is string && data.photoPublicId.size() <= 200))
        && data.createdAt is timestamp;
    }

    function isValidUserPostRef(data, postId) {
      return hasRequiredFields(data, ['postId', 'createdAt'])
        && hasOnlyAllowedFields(data, ['postId', 'createdAt'])
        && data.postId is string
        && data.postId.size() > 0
        && data.postId.size() <= 128
        && data.postId == postId
        && data.createdAt is timestamp;
    }

    function isValidFollowingDoc(data, targetUid) {
      return hasRequiredFields(data, ['targetUid', 'createdAt'])
        && hasOnlyAllowedFields(data, ['targetUid', 'createdAt'])
        && data.targetUid is string
        && data.targetUid.size() > 0
        && data.targetUid.size() <= 128
        && data.targetUid == targetUid
        && data.createdAt is timestamp;
    }

    function isValidFollowerDoc(data, followerUid) {
      return hasRequiredFields(data, ['uid', 'createdAt'])
        && hasOnlyAllowedFields(data, ['uid', 'createdAt'])
        && data.uid is string
        && data.uid.size() > 0
        && data.uid.size() <= 128
        && data.uid == followerUid
        && data.createdAt is timestamp;
    }

    function isValidPostMedia(data) {
      return data.mediaUrl is string
        && data.mediaPath is string
        && data.mediaPublicId is string
        && data.mediaType in ['text', 'image', 'video']
        && (
          (data.mediaType == 'text'
            && data.mediaUrl == ''
            && data.mediaPath == ''
            && data.mediaPublicId == '')
          || (data.mediaType == 'image'
            && data.mediaPath == ''
            && (
              (isValidCloudinaryImageUrl(data.mediaUrl)
                && data.mediaPublicId.size() > 0
                && data.mediaPublicId.size() <= 200)
              || (isValidCompressedImageDataUrl(data.mediaUrl, 700000)
                && data.mediaPublicId == '')
            ))
          || (data.mediaType == 'video'
            && isValidCloudinaryVideoUrl(data.mediaUrl)
            && data.mediaPublicId.size() > 0
            && data.mediaPublicId.size() <= 200
            && data.mediaPath == '')
        );
    }

    function isValidPostCreate(data) {
      return hasRequiredFields(data, ['uid', 'username', 'caption', 'mediaUrl', 'mediaPath', 'mediaPublicId', 'mediaType', 'createdAt'])
        && hasOnlyAllowedFields(data, ['uid', 'username', 'caption', 'mediaUrl', 'mediaPath', 'mediaPublicId', 'mediaType', 'createdAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && data.username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && data.caption is string
        && data.caption.size() <= 2200
        && isValidPostMedia(data)
        && data.createdAt is timestamp;
    }

    function isValidPostUpdate(data, existingData) {
      return data.diff(existingData).affectedKeys().hasOnly(['username'])
        && data.uid is string
        && data.uid == existingData.uid
        && isValidUsername(data.username)
        && data.username == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
    }

    function isValidLike(data) {
      return hasRequiredFields(data, ['uid', 'createdAt'])
        && hasOnlyAllowedFields(data, ['uid', 'createdAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidComment(data) {
      return hasRequiredFields(data, ['uid', 'username', 'photoURL', 'text', 'createdAt'])
        && hasOnlyAllowedFields(data, ['uid', 'username', 'photoURL', 'text', 'createdAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidUsername(data.username)
        && isValidAvatarUrl(data.photoURL)
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return hasRequiredFields(data, ['recipientUid', 'senderUid', 'senderUsername', 'type', 'postId', 'commentId', 'message', 'read', 'createdAt'])
        && hasOnlyAllowedFields(data, ['recipientUid', 'senderUid', 'senderUsername', 'type', 'postId', 'commentId', 'message', 'read', 'createdAt'])
        && data.recipientUid is string
        && data.recipientUid.size() > 0
        && data.recipientUid.size() <= 128
        && data.senderUid is string
        && data.senderUid.size() > 0
        && data.senderUid.size() <= 128
        && isValidUsername(data.senderUsername)
        && data.type in ['like', 'comment', 'mention', 'follow']
        && data.postId is string
        && data.postId.size() <= 128
        && data.commentId is string
        && data.commentId.size() <= 128
        && data.message is string
        && data.message.size() <= 500
        && data.read is bool
        && data.createdAt is timestamp;
    }

    // Default deny untuk semua jalur koleksi lain yang tidak didefinisikan secara eksplisit
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // KOLEKSI: users (/users/{uid})
    // ==========================================
    match /users/{uid} {
      // Pengguna yang sudah login boleh membaca profil pengguna lain (untuk cek username unik & profil feed)
      allow read: if isAuthenticated();

      // Pembuatan profil awal:
      // - Hanya boleh untuk UID sendiri saat registrasi
      // - Wajib memiliki field: email, username, bio, createdAt
      // - Opsional field: photoURL, photoPublicId
      // - Email harus sama dengan email autentikasi Firebase
      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.email == request.auth.token.email;

      // Pembaruan profil:
      // - Hanya boleh mengubah field username, bio, photoURL, dan photoPublicId oleh pemilik akun
      // - Field email, createdAt, dan UID tidak boleh diganti
      // - photoURL divalidasi dengan isValidAvatarUrl() (kosong, Cloudinary image, atau Data URL <= 85KB)
      allow update: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'bio', 'photoURL', 'photoPublicId'])
        && areImmutableFieldsUnchanged(['email', 'createdAt']);

      // Penghapusan profil: hanya boleh dilakukan pemilik akun sendiri
      allow delete: if isOwner(uid);

      // ==========================================
      // SUBKOLEKSI: bookmarks (/users/{uid}/bookmarks/{postId})
      // ==========================================
      match /bookmarks/{postId} {
        // Hanya pemilik akun yang dapat membaca bookmark pribadinya
        allow read: if isOwner(uid);

        // Menambah atau memperbarui bookmark: hanya pemilik akun, wajib menyimpan postId dan createdAt
        allow create, update: if isOwner(uid)
          && isValidUserPostRef(request.resource.data, postId);

        // Membatalkan bookmark: hanya pemilik akun
        allow delete: if isOwner(uid);
      }

      // ==========================================
      // SUBKOLEKSI: hiddenPosts (/users/{uid}/hiddenPosts/{postId})
      // ==========================================
      match /hiddenPosts/{postId} {
        // Hanya pemilik akun yang dapat membaca daftar postingan disembunyikan pribadinya
        allow read: if isOwner(uid);

        // Menyembunyikan atau memperbarui postingan tersembunyi: hanya pemilik akun
        allow create, update: if isOwner(uid)
          && isValidUserPostRef(request.resource.data, postId);

        // Mengembalikan postingan yang disembunyikan: hanya pemilik akun
        allow delete: if isOwner(uid);
      }

      // ==========================================
      // SUBKOLEKSI: following (/users/{uid}/following/{targetUid})
      // ==========================================
      match /following/{targetUid} {
        // Pengguna terautentikasi dapat melihat daftar pengguna yang diikuti
        allow read: if isAuthenticated();

        // Mengikuti pengguna lain: hanya pemilik akun, tidak boleh mengikuti diri sendiri
        allow create, update: if isOwner(uid)
          && uid != targetUid
          && isValidFollowingDoc(request.resource.data, targetUid);

        // Berhenti mengikuti: hanya pemilik akun
        allow delete: if isOwner(uid);
      }

      // ==========================================
      // SUBKOLEKSI: followers (/users/{uid}/followers/{followerUid})
      // ==========================================
      match /followers/{followerUid} {
        // Pengguna terautentikasi dapat melihat daftar pengikut pengguna
        allow read: if isAuthenticated();

        // Menambahkan diri sebagai pengikut: hanya pengikut yang bersangkutan, tidak boleh mengikuti diri sendiri
        allow create, update: if isOwner(followerUid)
          && uid != followerUid
          && isValidFollowerDoc(request.resource.data, followerUid);

        // Menghapus status pengikut: boleh dilakukan oleh pengikut (unfollow) maupun pemilik profil
        allow delete: if isOwner(followerUid) || isOwner(uid);
      }
    }

    // ==========================================
    // KOLEKSI: posts (/posts/{postId})
    // ==========================================
    match /posts/{postId} {
      // Pengguna yang sudah login boleh membaca seluruh postingan feed
      allow read: if isAuthenticated();

      // Pembuatan postingan:
      // - Hanya untuk UID sendiri dengan username sinkron dengan dokumen profil Firestore
      // - Mendukung teks, foto/video Cloudinary, dan foto terkompresi fallback Firestore (Data URL <= 700000)
      allow create: if isAuthenticated()
        && uidUnchanged()
        && isValidPostCreate(request.resource.data);

      // Pembaruan postingan:
      // - Hanya boleh mengubah field username oleh pemilik postingan
      // - Username baru wajib sama dengan username profil pemilik yang sudah diperbarui di Firestore
      // - UID, createdAt, caption, dan field media tidak boleh berubah
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && uidNotModified()
        && areImmutableFieldsUnchanged(['uid', 'caption', 'mediaUrl', 'mediaPath', 'mediaPublicId', 'mediaType', 'createdAt'])
        && isValidPostUpdate(request.resource.data, resource.data);

      // Penghapusan postingan: hanya oleh pemilik postingan
      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;

      // ==========================================
      // SUBKOLEKSI: likes (/posts/{postId}/likes/{uid})
      // ==========================================
      match /likes/{uid} {
        // Setiap pengguna terautentikasi dapat melihat status Like
        allow read: if isAuthenticated();

        // Memberikan Like:
        // - Hanya boleh menggunakan ID dokumen sama dengan UID pengirim (mencegah like ganda)
        // - Mengizinkan create & update (upsert aman via setDoc)
        allow create: if isOwner(uid)
          && uidUnchanged()
          && isValidLike(request.resource.data);

        allow update: if isOwner(uid)
          && uidNotModified()
          && areImmutableFieldsUnchanged(['uid'])
          && isValidLike(request.resource.data);

        // Membatalkan Like: hanya pemilik Like yang bersangkutan
        allow delete: if isOwner(uid);
      }

      // ==========================================
      // SUBKOLEKSI: comments (/posts/{postId}/comments/{commentId})
      // ==========================================
      match /comments/{commentId} {
        // Setiap pengguna terautentikasi dapat membaca komentar pada postingan
        allow read: if isAuthenticated();

        // Menambahkan atau memperbarui komentar milik sendiri:
        // - photoURL divalidasi dengan isValidAvatarUrl() (kosong, Cloudinary image, atau Data URL <= 85KB)
        allow create: if isAuthenticated()
          && uidUnchanged()
          && isValidComment(request.resource.data);

        allow update: if isAuthenticated()
          && resource.data.uid == request.auth.uid
          && uidNotModified()
          && areImmutableFieldsUnchanged(['uid', 'createdAt'])
          && isValidComment(request.resource.data);

        // Menghapus komentar: hanya pemilik komentar yang bersangkutan
        allow delete: if isAuthenticated()
          && resource.data.uid == request.auth.uid;
      }
    }

    // ==========================================
    // KOLEKSI: notifications (/notifications/{notificationId})
    // ==========================================
    match /notifications/{notificationId} {
      // Pengguna hanya boleh membaca notifikasi miliknya sendiri (sebagai penerima)
      allow read: if isAuthenticated()
        && resource.data.recipientUid == request.auth.uid;

      // Pembuatan notifikasi:
      // - Pengirim harus pengguna terautentikasi (senderUid == request.auth.uid)
      // - Tidak boleh mengirim notifikasi ke diri sendiri (recipientUid != request.auth.uid)
      // - Status read wajib bernilai false saat dibuat
      allow create: if isAuthenticated()
        && isValidNotification(request.resource.data)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.read == false;

      // Memperbarui notifikasi (menandai sudah dibaca):
      // - Hanya penerima notifikasi yang berhak mengubah
      // - Hanya field 'read' yang boleh diperbarui
      allow update: if isAuthenticated()
        && resource.data.recipientUid == request.auth.uid
        && isValidNotification(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && areImmutableFieldsUnchanged(['recipientUid', 'senderUid', 'senderUsername', 'type', 'postId', 'commentId', 'message', 'createdAt']);

      // Menghapus notifikasi: hanya oleh penerima notifikasi
      allow delete: if isAuthenticated()
        && resource.data.recipientUid == request.auth.uid;
    }
  }
}
